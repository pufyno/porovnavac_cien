# Pripojenie na PostgreSQL 17 (povinné).
DATABASE_URL=postgres://porovnavac:HESLO@127.0.0.1:5432/porovnavac

# Port a adresa, na ktorých aplikácia počúva. Na internet ju vystavuje reverzný proxy.
PORT=3000
HOST=127.0.0.1

# Verejná adresa webu a adresa, na ktorej beží /redirect (môže byť rovnaká).
PUBLIC_BASE_URL=https://DOMENA
REDIRECT_BASE_URL=https://DOMENA

# Názov služby v hlavičke webu a v e-mailoch.
SITE_NAME=Cenoradar

# Prevádzkovateľ podľa § 4 zákona č. 22/2004 Z. z. Zobrazí sa na /o-nas a /ochrana-sukromia.
# Fyzická osoba uvádza meno, adresu bydliska, e-mail a telefón. Chýbajúce údaje web označí na doplnenie.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
# IČO, register a číslo zápisu, IČ DPH; len ak sú.
OPERATOR_REGISTRATION=
